---
import Layout from '../layouts/Layout.astro';
import ProjectCard from '../components/ProjectCard.astro';
import { featured } from '../data/projects';

const ribbonItems = [
  'ROS 2', 'İHA güdüm', 'CHIP-8', 'C / C++', 'Python', 'gömülü sistemler',
  'sinyal işleme', 'Gazebo', 'Linux', 'kontrol teorisi', 'sıfırdan derleme',
];
const ribbonItemsEN = [
  'ROS 2', 'UAV guidance', 'CHIP-8', 'C / C++', 'Python', 'embedded systems',
  'signal processing', 'Gazebo', 'Linux', 'control theory', 'build from scratch',
];
---

<Layout>
  <!-- HERO -->
  <section class="hero">
    <div class="triangle-deco" aria-hidden="true">
      <div class="spin3d">
        <svg viewBox="0 0 106 106">
          <!-- arka yüz: 3B derinlik hissi -->
          <polygon points="16,24 100,24 58,98" fill="#963224" stroke="#241f1a" stroke-width="3" stroke-linejoin="round" />
          <!-- ön yüz -->
          <polygon points="8,16 92,16 50,90" fill="#e2503f" stroke="#241f1a" stroke-width="3" stroke-linejoin="round" />
        </svg>
      </div>
    </div>

    <div class="container hero-grid">
      <div class="hero-copy">
        <h1 class="hero-title">yigiterf</h1>
        <p class="hero-sub" data-en="Robotics & embedded systems developer">Robotik & gömülü sistemler geliştiricisi</p>
        <p class="hero-summary" data-en="I work on robotics, embedded systems and simulation. I develop ROS 2 guidance simulations, build a CHIP-8 emulator from scratch, and work on UAV autonomy.">
          Robotik, gömülü sistemler ve simülasyon üzerine çalışıyorum. ROS 2 ile güdüm
          simülasyonları geliştiriyor, sıfırdan CHIP-8 emülatörü yazıyor ve İHA otonomisi
          üzerine çalışıyorum.
        </p>
        <div class="chip-row">
          <span class="chip mint">ROS 2</span>
          <span class="chip lilac" data-en="UAV">İHA</span>
          <span class="chip sky">C / C++</span>
          <span class="chip peach">Python</span>
          <span class="chip lilac">CHIP-8</span>
          <span class="chip mint">Gazebo</span>
        </div>
        <div class="hero-cta">
          <a class="btn btn-primary" href="#projects" data-en="Browse projects">Projelere göz at</a>
          <a class="btn" href="#contact" data-en="Contact me">İletişime geç</a>
        </div>
      </div>

      <aside class="spec-card" aria-label="Künye kartı">
        <div class="spec-stripe">
          <span>yigiterf — künye</span>
          <span>since 2019</span>
        </div>
        <dl class="spec-list">
          <div><dt data-en="focus">odak</dt><dd>ROS 2 · İHA · emülatör</dd></div>
          <div><dt>stack</dt><dd>C · Python</dd></div>
          <div><dt data-en="fields">alanlar</dt><dd data-en="robotics · embedded · DSP">robotik · gömülü · DSP</dd></div>
        </dl>
        <div class="spec-stats">
          <div><b id="stat-repos">…</b><span data-en="repos">repo</span></div>
          <div><b id="stat-followers">…</b><span data-en="followers">takipçi</span></div>
          <div><b id="stat-following">…</b><span data-en="following">takip</span></div>
        </div>
      </aside>
    </div>
  </section>

  <!-- kayan şerit -->
  <div class="ribbon" aria-hidden="true">
    <div class="ribbon-track">
      {ribbonItems.map((item, i) => (
        <>
          <span data-en={ribbonItemsEN[i]}>{item}</span>
          <span class="dia">◆</span>
        </>
      ))}
      {ribbonItems.map((item, i) => (
        <>
          <span data-en={ribbonItemsEN[i]}>{item}</span>
          <span class="dia">◆</span>
        </>
      ))}
    </div>
  </div>

  <!-- PROJELER -->
  <section class="section" id="projects">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no">01</span>
        <h2 data-en="Projects">Projeler<span class="dot">.</span></h2>
        <span class="rule"></span>
      </div>
      <div class="figs">
        {featured.map((p, i) => <ProjectCard project={p} index={i} />)}
      </div>
      <p class="see-all">
        <a href="https://github.com/yigiterf?tab=repositories" target="_blank" rel="noopener" data-en="All projects on GitHub ↗">GitHub'daki tüm projeler ↗</a>
      </p>
    </div>
  </section>

  <!-- KONSOL -->
  <section class="section" id="terminal">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no" style="background:var(--sky)">02</span>
        <h2 data-en="Console">Konsol<span class="dot">.</span></h2>
        <span class="rule"></span>
      </div>
      <div class="term-paper">
        <div class="term-bar">
          <span class="term-dots"><span></span><span></span><span></span></span>
          <span class="term-title">yigiterf@github.io : bash</span>
          <span class="term-hint" data-en="tip: help">ipucu: help</span>
        </div>
        <div class="term-body" id="term-body">
          <div class="term-out" id="term-out"></div>
          <div class="term-line">
            <span class="term-prompt">➜ ~$</span>
            <input class="term-in" id="term-in" autocomplete="off" autocapitalize="off" spellcheck="false" aria-label="Terminal komut girişi" />
          </div>
        </div>
      </div>
      <p class="term-note" data-en="Type `help` to list commands — ArrowUp/Down navigates history.">
        Komutları listelemek için <code>help</code> yazın — ArrowUp/Down ile geçmişte gezinebilirsiniz.
      </p>
    </div>
  </section>

  <!-- SON REPOLAR (canlı) -->
  <section class="section" id="live">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no" style="background:var(--lilac)">03</span>
        <h2 data-en="Recent Repos">Son Repolar<span class="dot">.</span></h2>
        <span class="rule"></span>
      </div>
      <p class="muted" style="margin-top:-18px;margin-bottom:26px;font-size:.88rem" data-en="Listed automatically via the GitHub API.">
        GitHub API üzerinden otomatik listelenir.
      </p>
      <div class="figs" id="live-grid">
        <p class="mono muted" style="font-size:.8rem">⌛ yükleniyor…</p>
      </div>
    </div>
  </section>

  <!-- İLETİŞİM -->
  <section class="section" id="contact">
    <div class="container">
      <div class="sec-head">
        <span class="sec-no" style="background:var(--pink)">04</span>
        <h2 data-en="Contact">İletişim<span class="dot">.</span></h2>
        <span class="rule"></span>
      </div>
      <div class="contact-wrap">
        <h3 class="contact-title" data-en="Get in touch">Benimle iletişime geç</h3>
        <p class="contact-sub" data-en="For projects, collaboration or any questions, feel free to reach out.">
          Proje, iş birliği ya da sorularınız için bana ulaşabilirsiniz.
        </p>
        <div class="contact-links">
          <a class="btn btn-primary" href="https://github.com/yigiterf" target="_blank" rel="noopener">github.com/yigiterf ↗</a>
          <a class="btn" href="mailto:örnek@posta.com">örnek@posta.com ↗</a>
        </div>
        <!-- NOT: yukarıdaki mailto adresini kendi e-postanla değiştir -->
      </div>
    </div>
  </section>
</Layout>
