---
interface Props {
  project: import('../../data/projects').Project;
  index?: number;
}
const { project, index = 0 } = Astro.props;
const { title, url, language, tags, desc, date } = project;

// GitHub dil renkleri
const LANG_COLORS: Record<string, string> = {
  C: '#8a827a', 'C++': '#e2503f', Python: '#4f7ca8', JavaScript: '#d9b23c',
  TypeScript: '#4f7ca8', HTML: '#d97742', CSS: '#9b7fc4', CMake: '#c23d2e',
  Shell: '#5da271', Makefile: '#7a8b3c',
};
const langColor = LANG_COLORS[language] ?? '#8a827a';
const no = String(index + 1).padStart(2, '0');
---

<article class="fig">
  <header class="fig-plate">
    <span>{no}</span>
    <span class="fig-lang">
      <span class="lang-sq" style={`background:${langColor}`}></span>{language ?? 'n/a'}
    </span>
  </header>
  <div class="fig-body">
    <h3 class="fig-title"><a href={url} target="_blank" rel="noopener">{title}</a></h3>
    <p class="fig-desc" data-tr={desc.tr} data-en={desc.en} data-ja={desc.ja}>{desc.tr}</p>
    <ul class="fig-tags">
      {tags.tr.map((tag, i) => (
        <li class="chip" data-tr={tag} data-en={tags.en[i]} data-ja={tags.ja[i]}>{tag}</li>
      ))}
    </ul>
    <footer class="fig-foot">
      <a class="fig-link" href={url} target="_blank" rel="noopener" data-en="open ↗" data-ja="開く ↗">aç ↗</a>
      <span class="fig-date">{date?.slice(0, 7)}</span>
    </footer>
  </div>
</article>
