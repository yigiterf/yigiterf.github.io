---
// Görünüm alanına (viewport) sabit robot kolu: arada bir ekran kenarından
// belirir, kısa süre bekler, tekrar çekilir. Tamamı dekoratif (aria-hidden).
// Görsel "sağa uzanan" olarak çizili; sağ taraf için SVG aynalanır.
---

<aside class="robot-peek from-right" aria-hidden="true">
  <svg viewBox="0 0 150 110" role="presentation">
    <!-- montaj plakası (kenara bağlı görünür) -->
    <rect x="0" y="60" width="30" height="36" rx="4" fill="var(--butter)" stroke="var(--ink)" stroke-width="2" />
    <circle cx="7.5" cy="69" r="1.8" fill="var(--ink)" opacity="0.55" />
    <circle cx="7.5" cy="87" r="1.8" fill="var(--ink)" opacity="0.55" />
    <!-- kol segmentleri -->
    <path d="M20 78 L64 50" stroke="var(--ink)" stroke-width="11" stroke-linecap="round" />
    <path d="M20 78 L64 50" stroke="var(--mint)" stroke-width="5" stroke-linecap="round" />
    <circle cx="64" cy="50" r="8" fill="var(--butter)" stroke="var(--ink)" stroke-width="2" />
    <path d="M64 50 L100 66" stroke="var(--ink)" stroke-width="11" stroke-linecap="round" />
    <path d="M64 50 L100 66" stroke="var(--mint)" stroke-width="5" stroke-linecap="round" />
    <circle class="robo-led" cx="78" cy="55" r="3" fill="var(--red)" stroke="var(--ink)" stroke-width="1.5" />
    <!-- bilek + pençe -->
    <circle cx="100" cy="66" r="6.5" fill="var(--red)" stroke="var(--ink)" stroke-width="2" />
    <path d="M103 61 C 114 54 123 57 128 64" stroke="var(--ink)" stroke-width="3" fill="none" stroke-linecap="round" />
    <path d="M103 71 C 114 78 123 75 128 68" stroke="var(--ink)" stroke-width="3" fill="none" stroke-linecap="round" />
    <circle cx="134" cy="66" r="5" fill="var(--red)" stroke="var(--ink)" stroke-width="2" />
  </svg>
</aside>

<style is:global>
  .robot-peek {
    position: fixed;
    top: var(--peek-top, 42%);
    width: 130px;
    z-index: 40; /* sticky başlığın (z-50) altında kalır */
    pointer-events: none;
    transition:
      transform 0.9s cubic-bezier(0.22, 1.2, 0.36, 1),
      opacity 0.5s ease;
    opacity: 0;
  }
  .robot-peek svg { display: block; width: 100%; height: auto; }
  .robot-peek .robo-led { animation: robo-blink 1.7s steps(2) infinite; }
  @keyframes robo-blink { 50% { opacity: 0.25; } }

  /* sağ kenardan */
  .robot-peek.from-right { right: 0; top: var(--peek-top, 42%); }
  .robot-peek.from-right svg { transform: scaleX(-1); }
  .robot-peek.from-right { transform: translateX(112%) rotate(10deg); transform-origin: right center; }
  .robot-peek.from-right.is-in { transform: translateX(-10%) rotate(-4deg); opacity: 1; }

  /* sol kenardan */
  .robot-peek.from-left { left: 0; top: var(--peek-top, 42%); }
  .robot-peek.from-left { transform: translateX(-112%) rotate(-10deg); transform-origin: left center; }
  .robot-peek.from-left.is-in { transform: translateX(10%) rotate(4deg); opacity: 1; }

  .robot-peek.is-out { opacity: 0; }

  @media (max-width: 920px) { .robot-peek { display: none; } }
  @media (prefers-reduced-motion: reduce) { .robot-peek { display: none; } }
</style>
