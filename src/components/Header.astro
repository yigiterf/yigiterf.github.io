---
const links = [
  { href: '#projects', tr: 'projeler', en: 'projects', ja: 'プロジェクト' },
  { href: '#terminal', tr: 'konsol', en: 'console', ja: 'コンソール' },
  { href: '#live', tr: 'repolar', en: 'repos', ja: 'リポジトリ' },
  { href: '#contact', tr: 'iletişim', en: 'contact', ja: 'お問い合わせ' },
];
const langs = ['TR', 'EN', 'JA'];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="#top">
      <svg class="logo-mark" viewBox="0 0 106 106" aria-hidden="true">
        <polygon points="16,24 100,24 58,98" fill="#963224" />
        <polygon points="8,16 92,16 50,90" fill="#e2503f" stroke="#241f1a" stroke-width="4" stroke-linejoin="round" style="stroke:var(--ink)" />
      </svg>
      <span class="logo-word">yigiterf<span class="lab">·lab</span></span>
    </a>
    <nav aria-label="Ana menü / Main menu / メニュー">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-en={l.en} data-ja={l.ja}>{l.tr}</a></li>
        ))}
      </ul>
    </nav>
    <div class="header-tools">
      <button class="tema-btn" id="tema-btn" type="button" aria-label="Gece / gündüz modunu değiştir" title="gece / gündüz">
        <svg class="tema-ay" viewBox="0 0 20 20" aria-hidden="true">
          <path d="M15.5 12.2 A7 7 0 1 1 8 3.4 a5.6 5.6 0 1 0 7.5 8.8 Z" fill="currentColor" />
        </svg>
        <svg class="tema-gun" viewBox="0 0 20 20" aria-hidden="true">
          <circle cx="10" cy="10" r="4" fill="currentColor" />
          <path d="M10 1.2v2.2M10 16.6v2.2M18.8 10h-2.2M3.4 10H1.2M16.4 3.6l-1.6 1.6M5.2 14.8l-1.6 1.6M16.4 16.4l-1.6-1.6M5.2 5.2L3.6 3.6"
            stroke="currentColor" stroke-width="1.8" stroke-linecap="round" />
        </svg>
      </button>
      <div class="lang-switch" role="group" aria-label="Dil / Language / 言語">
        {langs.map((code) => (
          <button type="button" data-lang={code.toLowerCase()} class="lang-btn">{code}</button>
        ))}
      </div>
    </div>
  </div>
</header>
