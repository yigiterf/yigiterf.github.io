---
const links = [
  { href: '#projects', tr: 'projeler', en: 'projects', ja: 'プロジェクト' },
  { href: '#terminal', tr: 'konsol', en: 'console', ja: 'コンソール' },
  { href: '#live', tr: 'repolar', en: 'repos', ja: 'リポジトリ' },
  { href: '#contact', tr: 'iletişim', en: 'contact', ja: 'お問い合わせ' },
];
const langs = ['TR', 'EN', 'JA'];
---

<header class="site-header">
  <div class="container header-inner">
    <a class="logo" href="#top">
      <svg class="logo-mark" viewBox="0 0 106 106" aria-hidden="true">
        <polygon points="16,24 100,24 58,98" fill="#963224" />
        <polygon points="8,16 92,16 50,90" fill="#e2503f" stroke="#241f1a" stroke-width="4" stroke-linejoin="round" />
      </svg>
      <span class="logo-word">yigiterf<span class="lab">·lab</span></span>
    </a>
    <nav aria-label="Ana menü / Main menu / メニュー">
      <ul>
        {links.map((l) => (
          <li><a href={l.href} data-en={l.en} data-ja={l.ja}>{l.tr}</a></li>
        ))}
      </ul>
    </nav>
    <div class="lang-switch" role="group" aria-label="Dil / Language / 言語">
      {langs.map((code) => (
        <button type="button" data-lang={code.toLowerCase()} class="lang-btn">{code}</button>
      ))}
    </div>
  </div>
</header>
